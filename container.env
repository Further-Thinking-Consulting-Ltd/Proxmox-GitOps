# --- Container identity ---
CTID=500
DESCRIPTION="Gitea - managed by Proxmox-GitOps"
# # --- Template source ---
# # NAS_ISO must have vztmpl enabled
TEMPLATE_STORAGE=NAS_ISO
TEMPLATE=NFS_ISO:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst
# # --- Root disk placement ---
# # Use NAS (or another storage with rootdir/images enabled)
DISK=NAS:32
IP=192.168.3.25
ID="500"
CORES="2"
MEMORY="4096"
SWAP="1024"
MOUNTS=
BOOT="yes"
